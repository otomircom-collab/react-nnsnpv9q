<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ site.title }} - OtoMarketGo</title>
    <link rel="stylesheet" href="{{ themeAsset('scss/theme.scss') }}">
    {% block page_styles %}{% endblock %}
</head>
<body class="current-page-{{ site.route.group }}-{{ site.route.name }}">
    {% include 'html/snippets/header.twig' %}
    
    <main id="main">
        <div class="container">
            {% block breadcrumb %}{% endblock %}
            
            <section class="section-container">
                {% block content %}{% endblock %}
            </section>
        </div>
    </main>
    
    <footer id="footer">
        {% include 'html/snippets/footer.twig' %}
    </footer>
    
    {% include 'html/snippets/scripts.twig' %}
    {% block page_scripts %}{% endblock %}
</body>
</html>
